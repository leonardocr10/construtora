NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200
# Dominios pelos quais o visualizador 3D (porta 4300) e acessado de fora, separados por virgula (ex.: 3d.construtora.com.br).
# Acesso pelo IP do servidor funciona sem isso.
VIEWER_ALLOWED_HOSTS=
MYSQL_DATABASE=vistahub
# Usuario que a API Node.js usa para acessar somente os bancos do VistaHub.
MYSQL_USER=vistahub
MYSQL_PASSWORD=troque-esta-senha-local
# Senha root definida durante a instalacao do MySQL; necessaria apenas para criar o banco e o usuario acima.
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-local
# Pasta bin do MySQL/MariaDB (com mysql.exe), se nao for encontrada sozinha (ex.: C:/xampp/mysql/bin).
MYSQL_BIN=
# Codifique caracteres especiais na URL (por exemplo, @ vira %40).
DATABASE_URL="mysql://vistahub:troque-esta-senha-local@localhost:3306/vistahub"
SHADOW_DATABASE_URL="mysql://vistahub:troque-esta-senha-local@localhost:3306/vistahub_shadow"
# Diretorio local privado para arquivos enviados; nao deve ser servido diretamente pelo servidor web.
LOCAL_STORAGE_PATH="D:/construtora/realestate-platform/storage"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="gere-um-segredo-aleatorio-longo"
JWT_REFRESH_SECRET="gere-outro-segredo-aleatorio-longo"
# Tentativas de conexao ao MySQL na inicializacao da API.
DATABASE_CONNECT_RETRIES=5
# URLs publicas usadas no link de compartilhamento (previa no WhatsApp). Em producao use os dominios reais (https).
PUBLIC_API_URL="http://localhost:3000"
VIEWER_URL="http://localhost:4300"
# Gerador de GLB das torres: executavel do Blender 4.2+ (a versao portatil serve). Ver docs/blender-glb.md.
BLENDER_PATH="D:/construtora/tools/blender-5.2.2-windows-x64/blender.exe"
# Tempo limite de cada geracao (ms).
BLENDER_TIMEOUT_MS=180000

# Pasta bin do KTX-Software 4.3+ (Apache-2.0, https://github.com/KhronosGroup/KTX-Software). Com ela, os GLB
# das torres saem com texturas KTX2 (comprimidas na GPU). Sem ela, ficam em WebP. Ver docs/maquete-fotorrealista.md.
KTX_PATH=
