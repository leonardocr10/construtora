{
  "name": "realestate-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@vistahub/api",
    "dev:admin": "npm run start --workspace=@vistahub/admin-web",
    "dev:viewer": "npm run start --workspace=@vistahub/viewer",
    "build:viewer": "npm run build --workspace=@vistahub/viewer",
    "serve:viewer": "npm run preview --workspace=@vistahub/viewer",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@vistahub/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@vistahub/api --",
    "prisma:deploy": "npm run prisma:deploy --workspace=@vistahub/api",
    "db:init": "node scripts/db-init.mjs",
    "db:export": "node scripts/db-export.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:user": "node scripts/db-user.mjs",
    "db:status": "node scripts/with-env.mjs .env prisma migrate status --schema prisma/schema.prisma",
    "provision:admin": "node scripts/provision-admin.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "postinstall": "npm run build --workspace=@vistahub/geo && node scripts/viewer/sync-meshopt.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "meshoptimizer": "1.2.0"
  }
}
